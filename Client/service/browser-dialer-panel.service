[Unit]
Description=Xray Client Web Manager（面板）
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/xray-browser-dialer/scripts/run-panel.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xbd-panel

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# 诊断会读 nftables（`nft list table ...`，只读查询），而 nft 走 netlink ——
# 少了 AF_NETLINK 会报 "Unable to initialize Netlink socket"。
# （当年"接管局域网"模式要**写** nft 规则，这个坑就是那时踩出来的；模式已移除，
#   但只读查询仍然需要，所以保留。）其余保持收紧。
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# ProtectSystem=full 会把 /etc 与 /usr 挂成只读 —— 这对服务本身是好事。
# 面板只放行少数几个确实要写的位置，其余 /etc 仍然只读：
#   /opt/xray-browser-dialer/*          自己的配置、节点、日志、运行配置
#   /etc/profile.d/                     shell 环境变量
#   /etc/environment                    系统级环境变量
#
# 这里曾经还有一条 /etc/systemd/system/docker.service.d，是「接管本机」要写
# docker 代理覆盖用的。两个问题：该功能已下线；而且没装 Docker 的机器上这个
# 目录不存在，systemd 遇到不存在的 ReadWritePaths 会放弃整个单元 —— 面板
# 连脚本都还没开始跑就死了（226/NAMESPACE），日志里看不到任何面板自己的报错。
# 为一个可选功能把主功能绑架了。现在这段白名单里没有任何可能不存在的路径。
ReadWritePaths=/opt/xray-browser-dialer/runtime /opt/xray-browser-dialer/logs /opt/xray-browser-dialer/config /opt/xray-browser-dialer/nodes /opt/xray-browser-dialer/generated /etc/profile.d /etc/environment

[Install]
WantedBy=multi-user.target
